# ---- Database: Supabase is the SINGLE source of truth (DEC-054) ----
# Required in EVERY environment — the API refuses to boot without both values.
# There is no local SQLite fallback any more. Use the service_role key (RLS is deny-all,
# so anon/authenticated cannot read or write). Local dev and production share one project.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Mock gates — keep false. With one shared database, mock auth would let anyone sign in
# as any real patient using 123456. Production boot fails fast if mock auth is on (DEC-039).
ENABLE_MOCK_AUTH=false
ENABLE_MOCK_WHATSAPP=false

# DEC-051: WhatsApp credentials are configured in Admin > WhatsApp (system_settings),
# not here. ENABLE_MOCK_WHATSAPP=false is required for live sending.
# The two values below are only read by the optional template inspector script:
#   WHATSAPP_WABA_ID=... WHATSAPP_TOKEN=... node scripts/whatsapp-templates.mjs
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN=