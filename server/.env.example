# ---- Server mode ----
# LOCAL DEV (default): leave SUPABASE_URL empty -> embedded local driver (DEC-001)
# PRODUCTION / Supabase Cloud: set both values below; identical code runs on Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Mock gates (Blueprint §4A) — set false when real providers are wired
ENABLE_MOCK_AUTH=true
ENABLE_MOCK_WHATSAPP=true

# Phase 2: Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=