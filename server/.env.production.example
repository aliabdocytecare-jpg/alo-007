# PRODUCTION environment template (DEC-045/046/047). Copy to server/.env on the API server.
# Clean start: NO demo staff/patients are seeded when SUPABASE_URL is set + mock auth off.
# Bootstrap the single ALO Super Admin once: node scripts/create-admin.mjs (first-user-only).

# ---- Supabase (data + storage backend) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role / sb_secret_ key>

# ---- Server ----
PORT=3000
NODE_ENV=production
# Primary frontend origin first (magic links use it). Comma-separate to allow more origins.
CLIENT_ORIGIN=https://alodoc.online
# Strong random secret, >= 32 chars. Boot FAILS FAST if missing/short (DEC-039).
JWT_SECRET=<long-random-32+-chars>

# ---- Mock gates OFF in production ----
ENABLE_MOCK_AUTH=false
ENABLE_MOCK_WHATSAPP=false

# ---- Real providers (wire when ready) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=